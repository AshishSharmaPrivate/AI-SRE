import os
import time
import logging

from fastapi import FastAPI, Response
from prometheus_client import Counter, Histogram, generate_latest
from prometheus_client import CONTENT_TYPE_LATEST

app = FastAPI(title="Order API")

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s"
)

logger = logging.getLogger("order-service")

FAILURE_MODE = os.getenv("FAILURE_MODE", "true").lower() == "true"

REQUESTS = Counter(
    "http_requests_total",
    "Total HTTP requests",
    ["method", "path", "status"]
)

ERRORS = Counter(
    "http_errors_total",
    "Total HTTP errors",
    ["method", "path"]
)

LATENCY = Histogram(
    "http_request_duration_seconds",
    "HTTP request duration",
    ["method", "path"]
)


@app.get("/")
def root():
    return {
        "service": "order-service",
        "status": "running",
        "failure_mode": FAILURE_MODE
    }


@app.get("/health")
def health():
    REQUESTS.labels("GET", "/health", "200").inc()

    return {
        "status": "healthy",
        "failure_mode": FAILURE_MODE
    }


@app.get("/api/orders")
def orders():

    start = time.time()

    if FAILURE_MODE:

        time.sleep(3)

        REQUESTS.labels(
            "GET",
            "/api/orders",
            "500"
        ).inc()

        ERRORS.labels(
            "GET",
            "/api/orders"
        ).inc()

        LATENCY.labels(
            "GET",
            "/api/orders"
        ).observe(time.time() - start)

        logger.error(
            "Order API failed: downstream request timeout; "
            "operation=order_lookup latency_ms=%d",
            int((time.time() - start) * 1000)
        )

        return Response(
            content='{"error":"Order service degraded"}',
            status_code=500,
            media_type="application/json"
        )

    time.sleep(0.1)

    REQUESTS.labels(
        "GET",
        "/api/orders",
        "200"
    ).inc()

    LATENCY.labels(
        "GET",
        "/api/orders"
    ).observe(time.time() - start)

    logger.info(
        "Order request completed successfully latency_ms=%d",
        int((time.time() - start) * 1000)
    )

    return {
        "orders": [
            {
                "id": "ORD-1001",
                "status": "PROCESSING"
            },
            {
                "id": "ORD-1002",
                "status": "COMPLETED"
            }
        ]
    }


@app.get("/metrics")
def metrics():
    return Response(
        generate_latest(),
        media_type=CONTENT_TYPE_LATEST
    )

