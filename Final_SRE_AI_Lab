import os
import sys
import json
import time
import subprocess
from datetime import datetime, timezone

import boto3
import requests


PROMETHEUS_URL = "http://localhost:9090"

AWS_REGION = os.getenv(
    "AWS_REGION",
    "us-east-2"
)

MODEL_ID = os.getenv(
    "BEDROCK_MODEL_ID",
    "amazon.nova-lite-v1:0"
)

SLO_TARGET = float(
    os.getenv(
        "SLO_TARGET",
        "99"
    )
)


bedrock = boto3.client(
    "bedrock-runtime",
    region_name=AWS_REGION
)


def query_prometheus(query):
    try:
        response = requests.get(
            f"{PROMETHEUS_URL}/api/v1/query",
            params={"query": query},
            timeout=10
        )

        response.raise_for_status()

        data = response.json()

        results = data.get("data", {}).get("result", [])

        if not results:
            return None

        return results[0]["value"][1]

    except Exception as e:
        print(f"Prometheus query failed: {e}")
        return None


def get_metrics():
    error_rate = query_prometheus(
        '100 * sum(rate(http_requests_total{status=~"5.."}[1m])) '
        '/ sum(rate(http_requests_total[1m]))'
    )

    p95 = query_prometheus(
        'histogram_quantile(0.95, '
        'sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) * 1000'
    )

    requests_5m = query_prometheus(
        'sum(increase(http_requests_total[5m]))'
    )

    errors_5m = query_prometheus(
        'sum(increase(http_requests_total{status=~"5.."}[5m]))'
    )

    error_rate = float(error_rate) if error_rate is not None else 0.0
    p95 = float(p95) if p95 is not None else 0.0
    requests_5m = float(requests_5m) if requests_5m is not None else 0.0
    errors_5m = float(errors_5m) if errors_5m is not None else 0.0

    availability = 100.0 - error_rate

    slo_status = (
        "BREACHED"
        if availability < SLO_TARGET
        else "HEALTHY"
    )

    return {
        "error_rate_percent": error_rate,
        "p95_latency_ms": p95,
        "requests_last_5m": requests_5m,
        "errors_last_5m": errors_5m,
        "availability_percent": availability,
        "slo_target_percent": SLO_TARGET,
        "slo_status": slo_status
    }
def get_application_logs():

    try:

        result = subprocess.run(
            [
                "docker",
                "logs",
                "--tail",
                "80",
                "order-service"
            ],
            capture_output=True,
            text=True,
            timeout=10
        )

        return result.stdout[-8000:]

    except Exception as exc:

        return f"Unable to retrieve logs: {exc}"


def build_evidence():

    metrics = get_metrics()

    logs = get_application_logs()

    evidence = {
        "timestamp_utc": datetime.now(
            timezone.utc
        ).isoformat(),

        "service": "order-service",

        "metrics": metrics,

        "application_logs": logs,

        "observed_slo_status": (
            "BREACHED"
            if isinstance(
                metrics["availability_percent"],
                (float, int)
            )
            and metrics["availability_percent"] < SLO_TARGET
            else "NOT_BREACHED"
        )
    }

    return evidence


def ask_ai(evidence):

    prompt = f"""
You are an SRE incident investigation assistant.

Analyze ONLY the evidence provided below.

Rules:

1. Use only the supplied metrics and application logs.
2. Do not invent databases, external APIs, infrastructure,
   network failures, deployments, or dependencies.
3. Clearly distinguish observed facts from hypotheses.
4. If the evidence directly identifies the application failure
   mode, state that as the root-cause hypothesis.
5. Do not execute remediation.
6. Human SRE approval is required before remediation.
7. Availability below the SLO target means BREACHED.
8. Availability equal to or above the SLO target means HEALTHY.

Evidence:

{json.dumps(evidence, indent=2)}

Return JSON only:

{{
  "incident": "...",
  "severity": "...",
  "affected_service": "...",
  "customer_impact": "...",
  "observed_facts": [],
  "root_cause_hypothesis": "...",
  "confidence": "...",
  "recommended_action": "...",
  "validation": [],
  "slo_status": "BREACHED or HEALTHY"
}}
"""

    response = bedrock.converse(

        modelId=MODEL_ID,

        system=[
            {
                "text":
                "You are an experienced production SRE and incident investigator."
            }
        ],

        messages=[
            {
                "role": "user",
                "content": [
                    {
                        "text": prompt
                    }
                ]
            }
        ],

        inferenceConfig={
            "maxTokens": 1200,
            "temperature": 0.1,
            "topP": 0.9
        }
    )

    text = response[
        "output"
    ][
        "message"
    ][
        "content"
    ][0][
        "text"
    ]

    return text


def save_artifact(
    filename,
    content
):

    os.makedirs(
        "/opt/ai-sre-lab/reports",
        exist_ok=True
    )

    path = (
        "/opt/ai-sre-lab/reports/"
        + filename
    )

    with open(
        path,
        "w"
    ) as file:

        file.write(content)

    return path


def investigation():

    print("\n====================================")
    print("AI SRE INCIDENT INVESTIGATION")
    print("====================================\n")

    evidence = build_evidence()

    print("Collected Evidence:")
    print(
        json.dumps(
            evidence,
            indent=2
        )
    )

    print("\nCalling Amazon Bedrock...\n")

    try:

        analysis = ask_ai(
            evidence
        )

    except Exception as exc:

        analysis = json.dumps(
            {
                "error":
                f"Bedrock invocation failed: {exc}"
            },
            indent=2
        )

    print("\nAI RCA:")
    print(analysis)

    save_artifact(
        "latest_evidence.json",
        json.dumps(
            evidence,
            indent=2
        )
    )

    save_artifact(
        "latest_ai_rca.json",
        analysis
    )


def validation():

    print("\n====================================")
    print("SRE VALIDATION")
    print("====================================\n")

    time.sleep(5)

    metrics = get_metrics()

    print(
        json.dumps(
            metrics,
            indent=2
        )
    )

    try:

        error_rate = float(
            metrics["error_rate_percent"]
        )

        p95 = float(
            metrics["p95_latency_ms"]
        )

        availability = float(
            metrics["availability_percent"]
        )

        checks = {

            "error_rate":
                error_rate < 1.0,

            "p95_latency":
                p95 < 1000,

            "availability":
                availability >= SLO_TARGET
        }

    except Exception:

        checks = {
            "error_rate": False,
            "p95_latency": False,
            "availability": False
        }

    print("\nValidation Results:")

    for check, result in checks.items():

        print(
            f"{check}: "
            f"{'PASS' if result else 'FAIL'}"
        )

    passed = all(
        checks.values()
    )

    print(
        "\nOVERALL:",
        "PASS" if passed else "FAIL"
    )

    result = {
        "timestamp": datetime.now(
            timezone.utc
        ).isoformat(),

        "metrics": metrics,

        "checks": checks,

        "overall": (
            "PASS"
            if passed
            else "FAIL"
        )
    }

    save_artifact(
        "validation.json",
        json.dumps(
            result,
            indent=2
        )
    )


def incident_report():

    print("\n====================================")
    print("AI SRE INCIDENT REPORT")
    print("====================================\n")

    evidence_path = (
        "/opt/ai-sre-lab/reports/"
        "latest_evidence.json"
    )

    rca_path = (
        "/opt/ai-sre-lab/reports/"
        "latest_ai_rca.json"
    )

    validation_path = (
        "/opt/ai-sre-lab/reports/"
        "validation.json"
    )

    def read_file(path):

        try:

            with open(path) as f:
                return f.read()

        except Exception:
            return "Not available"

    evidence = read_file(
        evidence_path
    )

    rca = read_file(
        rca_path
    )

    validation_result = read_file(
        validation_path
    )

    prompt = f"""
Create a concise production incident report.

Use only the supplied evidence.

Include:

- Incident summary
- Customer impact
- Detection
- Timeline
- Observed evidence
- Root cause
- Root cause confidence
- Remediation
- Validation
- SLO impact
- Preventive actions
- AI contribution
- Human decisions

Clearly distinguish facts from hypotheses.

Evidence:

{evidence}

AI RCA:

{rca}

Validation:

{validation_result}
"""

    try:

        response = bedrock.converse(

            modelId=MODEL_ID,

            messages=[
                {
                    "role": "user",
                    "content": [
                        {
                            "text": prompt
                        }
                    ]
                }
            ],

            inferenceConfig={
                "maxTokens": 1800,
                "temperature": 0.1
            }
        )

        report = response[
            "output"
        ][
            "message"
        ][
            "content"
        ][0][
            "text"
        ]

    except Exception as exc:

        report = (
            "Unable to generate AI report: "
            + str(exc)
        )

    path = save_artifact(
        "incident_report.md",
        report
    )

    print(report)

    print(
        f"\nReport saved to: {path}"
    )


def main():

    command = (
        sys.argv[1]
        if len(sys.argv) > 1
        else "investigate"
    )

    if command == "investigate":

        investigation()

    elif command == "validate":

        validation()

    elif command == "report":

        incident_report()

    else:

        print(
            "Usage:"
        )

        print(
            "python3 ai_sre.py investigate"
        )

        print(
            "python3 ai_sre.py validate"
        )

        print(
            "python3 ai_sre.py report"
        )


if __name__ == "__main__":
    main()


